"""Small, standalone radar door for Mystic BBS 1.12 A48."""

import json
import math
import time

import mystic_bbs as bbs


AIRCRAFT_FILE = "/home/mystic/doors/data/aircraft.json"
RECEIVER_LATITUDE = 58.662
RECEIVER_LONGITUDE = 6.717
DEFAULT_RANGE_NM = 100
EARTH_RADIUS_NM = 3440.065

ESC = "\x1b["
SCREEN_WIDTH = 79
SCREEN_HEIGHT = 24
RADAR_PANEL_LEFT = 2
RADAR_PANEL_RIGHT = 58
RADAR_PANEL_TOP = 3
RADAR_PANEL_BOTTOM = 15
RADAR_PANEL_WIDTH = RADAR_PANEL_RIGHT - RADAR_PANEL_LEFT + 1
RADAR_PANEL_HEIGHT = RADAR_PANEL_BOTTOM - RADAR_PANEL_TOP + 1
RADAR_CENTER_X = RADAR_PANEL_LEFT + RADAR_PANEL_WIDTH / 2.0
RADAR_CENTER_Y = RADAR_PANEL_TOP + (RADAR_PANEL_HEIGHT - 1) / 2.0
RADAR_RADIUS_X = RADAR_PANEL_WIDTH / 2.0 - 0.75
RADAR_RADIUS_Y = (RADAR_PANEL_HEIGHT - 1) / 2.0 - 0.35
RADAR_CENTER_ROW = int(math.floor(RADAR_CENTER_Y + 0.5))
RADAR_RING_COUNT = 4
RADAR_RING_SAMPLES = 72
DETAILS_LEFT = 60
RADAR_DIVIDER = 59

# Keep terminal styling in one place so the screen remains readable in source.
RESET = ESC + "0m"
BRIGHT_CYAN = ESC + "96m"
CYAN = ESC + "36m"
DIM_CYAN = ESC + "2;36m"
WHITE = ESC + "37m"
YELLOW = ESC + "93m"
RED = ESC + "91m"


def numeric(value):
    if isinstance(value, bool):
        return None
    if isinstance(value, (int, float)):
        return float(value)
    return None


def read_aircraft():
    """Read a fresh snapshot, returning a safe error for bad source data."""
    try:
        with open(AIRCRAFT_FILE, "r") as source:
            document = json.load(source)
    except (IOError, OSError, ValueError) as error:
        return [], "data unavailable: " + str(error)

    aircraft = document.get("aircraft") if isinstance(document, dict) else None
    if not isinstance(aircraft, list):
        return [], "data unavailable: no aircraft array"
    return aircraft, ""


def haversine_nm(latitude, longitude):
    """Return distance from the receiver using a compact haversine form."""
    lat1 = math.radians(RECEIVER_LATITUDE)
    lat2 = math.radians(latitude)
    delta_lat = math.radians(latitude - RECEIVER_LATITUDE)
    delta_lon = math.radians(longitude - RECEIVER_LONGITUDE)
    sine_lat = math.sin(delta_lat / 2.0)
    sine_lon = math.sin(delta_lon / 2.0)
    value = sine_lat * sine_lat + math.cos(lat1) * math.cos(lat2) * sine_lon * sine_lon
    return 2.0 * EARTH_RADIUS_NM * math.atan2(math.sqrt(value), math.sqrt(1.0 - value))


def bearing_deg(latitude, longitude):
    lat1 = math.radians(RECEIVER_LATITUDE)
    lat2 = math.radians(latitude)
    delta_lon = math.radians(longitude - RECEIVER_LONGITUDE)
    y_value = math.sin(delta_lon) * math.cos(lat2)
    x_value = math.cos(lat1) * math.sin(lat2) - math.sin(lat1) * math.cos(lat2) * math.cos(delta_lon)
    return (math.atan2(y_value, x_value) * 180.0 / math.pi + 360.0) % 360.0


def aircraft_name(item):
    callsign = item.get("flight")
    if isinstance(callsign, str) and callsign.strip():
        return callsign.strip()
    for field in ("hex", "icao"):
        value = item.get(field)
        if value is not None and str(value):
            return str(value)
    return "unknown"


def is_ground(item):
    return str(item.get("alt_baro", "")).lower() == "ground" or bool(item.get("ground"))


def prepare_aircraft(source, range_nm, include_ground):
    visible = []
    for item in source:
        if not isinstance(item, dict) or (not include_ground and is_ground(item)):
            continue
        latitude = numeric(item.get("lat"))
        longitude = numeric(item.get("lon"))
        if latitude is None or longitude is None:
            continue
        if latitude < -90.0 or latitude > 90.0 or longitude < -180.0 or longitude > 180.0:
            continue
        distance = haversine_nm(latitude, longitude)
        if distance > range_nm:
            continue
        visible.append({
            "item": item,
            "name": aircraft_name(item),
            "distance": distance,
            "bearing": bearing_deg(latitude, longitude),
        })
    visible.sort(key=lambda aircraft: aircraft["distance"])
    return visible


def project(bearing, distance, range_nm):
    """Project a range/bearing into the panel-derived radar ellipse."""
    angle = math.radians(bearing)
    fraction = distance / range_nm if range_nm else 0.0
    column = radar_round(RADAR_CENTER_X + math.sin(angle) * RADAR_RADIUS_X * fraction)
    row = radar_round(RADAR_CENTER_Y - math.cos(angle) * RADAR_RADIUS_Y * fraction)
    return row, column


def radar_round(value):
    return int(math.floor(value + 0.5))


def put(screen, row, column, text, colour_grid=None, colour=None,
        min_column=1, max_column=SCREEN_WIDTH):
    if (row < 0 or row >= SCREEN_HEIGHT or column < min_column or
            column > max_column):
        return
    start = column - 1
    available = max_column - start
    text = str(text)[:available]
    screen[row][start:start + len(text)] = list(text)
    if colour_grid is not None and colour is not None:
        colour_grid[row][start:start + len(text)] = [colour] * len(text)


def radar_put(screen, row, column, text, colour_grid=None, colour=None):
    """Draw a one-based radar coordinate inside the fixed panel."""
    if (RADAR_PANEL_TOP <= row <= RADAR_PANEL_BOTTOM and
            RADAR_PANEL_LEFT <= column <= RADAR_PANEL_RIGHT):
        put(screen, row - 1, column, text, colour_grid, colour,
            RADAR_PANEL_LEFT, RADAR_PANEL_RIGHT)


def screen_output(screen, colours):
    rows = []
    for row, colour_row in zip(screen, colours):
        rendered = []
        previous = None
        for character, colour in zip(row, colour_row):
            if colour != previous:
                if previous is not None:
                    rendered.append(RESET)
                if colour is not None:
                    rendered.append(colour)
                previous = colour
            rendered.append(character)
        if previous is not None:
            rendered.append(RESET)
        rows.append("".join(rendered))
    return "\r\n".join(rows)


def value_text(item, field, digits=0):
    value = numeric(item.get(field))
    if value is None:
        return "?"
    if digits:
        return ("%." + str(digits) + "f") % value
    return str(int(round(value)))


def age_text(item):
    value = numeric(item.get("seen"))
    if value is None:
        value = numeric(item.get("seen_pos"))
    if value is None:
        return "?"
    return str(max(0, int(round(value)))) + "s"


def vertical_speed_text(item):
    for field in ("baro_rate", "geom_rate", "vs"):
        value = numeric(item.get(field))
        if value is not None:
            return str(int(round(value)))
    return "?"


def draw_screen(source, state):
    visible = prepare_aircraft(source, state["range"], state["ground"])
    if visible:
        state["selected"] %= len(visible)
    else:
        state["selected"] = 0

    screen = [list(" " * SCREEN_WIDTH) for unused in range(SCREEN_HEIGHT)]
    colours = [[None] * SCREEN_WIDTH for unused in range(SCREEN_HEIGHT)]

    # Header
    put(screen, 0, 2, "ANSIRADAR / MYSTIC", colours, BRIGHT_CYAN)
    put(screen, 0, 23, "RANGE %3d NM" % state["range"], colours, WHITE)
    put(screen, 0, 38, "AC %2d" % len(visible), colours, WHITE)
    put(screen, 0, 46, "SRC FILE", colours, WHITE)
    put(screen, 0, 57, "MODE LIVE", colours, CYAN)
    put(screen, 0, 69, time.strftime("%H:%M:%S"), colours, WHITE)

    # Full-width separators. The main radar/details area gets one extra row.
    put(screen, 1, 1, "+" + "-" * 77 + "+", colours, DIM_CYAN)
    put(screen, 15, 1, "+" + "-" * 77 + "+", colours, DIM_CYAN)
    put(screen, 21, 1, "+" + "-" * 77 + "+", colours, DIM_CYAN)

    # Radar box and divider.
    for scope_row in range(RADAR_PANEL_TOP, RADAR_PANEL_BOTTOM + 1):
        radar_put(screen, scope_row, RADAR_PANEL_LEFT, "|", colours, DIM_CYAN)
        radar_put(screen, scope_row, RADAR_PANEL_RIGHT, "|", colours, DIM_CYAN)
        put(screen, scope_row - 1, RADAR_DIVIDER, "|", colours, DIM_CYAN)

    center_col = radar_round(RADAR_CENTER_X)
    center_row = RADAR_CENTER_ROW

    # Keep N/E/S/W one cell clear of the visual walls.
    outer_top = radar_round(RADAR_CENTER_Y - RADAR_RADIUS_Y)
    outer_bottom = radar_round(RADAR_CENTER_Y + RADAR_RADIUS_Y)
    outer_left = radar_round(RADAR_CENTER_X - RADAR_RADIUS_X)
    outer_right = radar_round(RADAR_CENTER_X + RADAR_RADIUS_X)

    north_row = max(RADAR_PANEL_TOP + 1, outer_top + 1)
    south_row = min(RADAR_PANEL_BOTTOM - 1, outer_bottom - 1)
    west_col = max(RADAR_PANEL_LEFT + 2, outer_left + 2)
    east_col = min(RADAR_PANEL_RIGHT - 2, outer_right - 2)

    # Dotted range rings, now much denser/smoother.
    for ring_number in range(1, RADAR_RING_COUNT + 1):
        ring_fraction = ring_number / float(RADAR_RING_COUNT)
        for ring_sample in range(RADAR_RING_SAMPLES):
            ring_bearing = 360.0 * ring_sample / RADAR_RING_SAMPLES
            ring_row, ring_column = project(
                ring_bearing,
                state["range"] * ring_fraction,
                state["range"],
            )
            radar_put(screen, ring_row, ring_column, ".", colours, DIM_CYAN)

        # Range label around the upper-right quadrant of each ring.
        label_bearing = 48.0
        label_row, label_col = project(
            label_bearing,
            state["range"] * ring_fraction,
            state["range"],
        )
        ring_nm = int(round(state["range"] * ring_fraction))
        label = str(ring_nm)
        if label_col + len(label) < east_col:
            put(
                screen, label_row - 1, label_col + 1, label,
                colours, CYAN,
                RADAR_PANEL_LEFT + 1, RADAR_PANEL_RIGHT - 1
            )

    # Twelve outer-ring ticks.
    for tick_bearing in range(0, 360, 30):
        tick_row, tick_col = project(
            float(tick_bearing), float(state["range"]), float(state["range"])
        )
        radar_put(screen, tick_row, tick_col, "+", colours, CYAN)

    # Subtle sweep line. It advances only on normal screen refreshes.
    sweep_angle = math.radians(state.get("sweep_deg", 0.0))
    sweep_steps = 18
    for step in range(1, sweep_steps):
        fraction = step / float(sweep_steps)
        sweep_col = radar_round(
            RADAR_CENTER_X + math.sin(sweep_angle) * RADAR_RADIUS_X * fraction
        )
        sweep_row = radar_round(
            RADAR_CENTER_Y - math.cos(sweep_angle) * RADAR_RADIUS_Y * fraction
        )
        radar_put(screen, sweep_row, sweep_col, "*", colours, CYAN)

    # Full crosshair, stopping before the inset cardinal letters.
    for column in range(west_col + 1, east_col):
        radar_put(screen, center_row, column, ".", colours, DIM_CYAN)
    for row in range(north_row + 1, south_row):
        radar_put(screen, row, center_col, ".", colours, DIM_CYAN)
    radar_put(screen, center_row, center_col, "+", colours, BRIGHT_CYAN)

    # Aircraft
    for aircraft_index, aircraft in enumerate(visible):
        row, column = project(
            aircraft["bearing"], aircraft["distance"], state["range"]
        )

        occupied = {
            (center_row, center_col),
            (north_row, center_col),
            (south_row, center_col),
            (center_row, west_col),
            (center_row, east_col),
        }
        if (row, column) in occupied:
            column += 1

        glyph = "@" if aircraft_index == state["selected"] else "*"
        glyph_colour = YELLOW if aircraft_index == state["selected"] else WHITE
        radar_put(screen, row, column, glyph, colours, glyph_colour)

        if state["labels"] and RADAR_PANEL_TOP <= row <= RADAR_PANEL_BOTTOM:
            name = aircraft["name"][:8]

            # Visually separate target and label. Prefer the right side.
            if column + 2 + len(name) <= east_col - 1:
                label_col = column + 2
            else:
                label_col = max(west_col + 2, column - len(name) - 2)

            put(
                screen,
                row - 1,
                label_col,
                name,
                colours,
                YELLOW if aircraft_index == state["selected"] else CYAN,
                RADAR_PANEL_LEFT + 1,
                RADAR_PANEL_RIGHT - 1,
            )

    # Cardinals last so rings, sweep and labels never swallow them.
    radar_put(screen, north_row, center_col, "N", colours, BRIGHT_CYAN)
    radar_put(screen, south_row, center_col, "S", colours, BRIGHT_CYAN)
    radar_put(screen, center_row, west_col, "W", colours, BRIGHT_CYAN)
    radar_put(screen, center_row, east_col, "E", colours, BRIGHT_CYAN)

    # Selected-aircraft panel. Narrow but intentionally airy.
    selected = visible[state["selected"]] if visible else None
    detail_col = DETAILS_LEFT + 1
    put(screen, 2, detail_col, "SELECTED", colours, CYAN)

    if selected is None:
        put(screen, 4, detail_col, "-- NONE --", colours, WHITE)
    else:
        item = selected["item"]
        icao = str(item.get("hex", item.get("icao", "?")))[:6]
        altitude = "GND" if is_ground(item) else value_text(item, "alt_baro")

        put(screen, 3, detail_col, selected["name"][:18], colours, YELLOW)
        put(screen, 4, detail_col, "-" * 17, colours, DIM_CYAN)

        details = (
            (6, "ICAO", icao),
            (7, "ALT", altitude + (" FT" if altitude != "GND" else "")),
            (8, "SPD", value_text(item, "gs") + " KT"),
            (9, "HDG", value_text(item, "track") + " DEG"),
            (10, "RNG", "%.1f NM" % selected["distance"]),
            (11, "AGE", age_text(item)),
            (12, "V/S", vertical_speed_text(item)),
            (13, "TYPE", "---"),
            (14, "SQK", "----"),
        )
        for row, label, value in details:
            put(screen, row - 1, detail_col, label, colours, CYAN)
            put(screen, row - 1, detail_col + 6, value, colours, WHITE)

    # Aircraft table below the enlarged radar.
    put(
        screen,
        16,
        2,
        "CALL        ALT     SPD    HDG    RNG   AGE   ICAO    V/S",
        colours,
        BRIGHT_CYAN,
    )

    for row_offset in range(min(3, len(visible))):
        row = 17 + row_offset
        aircraft = visible[row_offset]
        item = aircraft["item"]
        altitude = "GND" if is_ground(item) else value_text(item, "alt_baro")
        icao = str(item.get("hex", item.get("icao", "?")))[:6]
        line = "%-11s %7s %6s %6s %6.1f %5s %7s %6s" % (
            aircraft["name"][:10],
            altitude,
            value_text(item, "gs"),
            value_text(item, "track"),
            aircraft["distance"],
            age_text(item),
            icao,
            vertical_speed_text(item),
        )
        if row_offset == state["selected"]:
            line = ">" + line[:78]
        put(
            screen,
            row,
            1,
            line,
            colours,
            YELLOW if row_offset == state["selected"] else WHITE,
        )

    status = state["error"] or (
        str(len(visible))
        + " aircraft | refresh 2s | labels "
        + ("CALL" if state["labels"] else "OFF")
        + " | ground "
        + ("ON" if state["ground"] else "OFF")
    )
    if state["paused"]:
        status = "PAUSED | " + status
    put(
        screen,
        20,
        2,
        status[:76],
        colours,
        RED if state["error"] else CYAN,
    )

    footer = (
        "J/K SELECT | +/- ZOOM | 1-4 RANGE | L LABELS | "
        "G GROUND | H HELP | Q QUIT"
    )
    put(screen, 22, 2, footer[:76], colours, WHITE)

    for key_text in ("J/K", "+/-", "1-4", "L", "G", "H", "Q"):
        position = footer.find(key_text)
        if position >= 0:
            put(screen, 22, 2 + position, key_text, colours, YELLOW)

    output = ESC + "2J" + ESC + "H"
    output += screen_output(screen, colours)
    bbs.rwrite(output)

def show_help(source, state):
    # Replace the radar/details area without changing the dashboard footprint.
    screen = [list(" " * SCREEN_WIDTH) for unused in range(SCREEN_HEIGHT)]
    colours = [[None] * SCREEN_WIDTH for unused in range(SCREEN_HEIGHT)]
    put(screen, 2, 2, "+----------------------- RADAR HELP -----------------------+", colours, BRIGHT_CYAN)
    put(screen, 3, 4, "Q       quit to Mystic", colours, WHITE)
    put(screen, 4, 4, "H / ?   show this help", colours, WHITE)
    put(screen, 5, 4, "J / K   select next / previous aircraft", colours, WHITE)
    put(screen, 6, 4, "+ / =   zoom in       -   zoom out", colours, WHITE)
    put(screen, 7, 4, "1 2 3 4 range: 25 / 50 / 100 / 200 nm", colours, WHITE)
    put(screen, 8, 4, "L       toggle radar labels", colours, WHITE)
    put(screen, 9, 4, "G       toggle ground aircraft", colours, WHITE)
    put(screen, 10, 4, "P       pause refresh  R       reload now", colours, WHITE)
    put(screen, 12, 4, "Press any key to return", colours, YELLOW)
    bbs.rwrite(ESC + "2J" + ESC + "H" + screen_output(screen, colours))
    while True:
        time.sleep(0.05)
        if bbs.keypressed:
            bbs.getkey()
            return


def handle_key(key, state, source):
    if isinstance(key, bytes):
        key = key.decode("ascii", "ignore")
    if not isinstance(key, str) or not key:
        return True, False, False
    key = key[:1].lower()
    if key == "q":
        return False, False, False
    if key in ("h", "?"):
        show_help(source, state)
        return True, True, False
    if key == "j":
        state["selected"] += 1
    elif key == "k":
        state["selected"] -= 1
    elif key in ("+", "="):
        state["range"] = min(200, state["range"] * 2)
    elif key == "-":
        state["range"] = max(25, state["range"] // 2)
    elif key in ("1", "2", "3", "4"):
        state["range"] = {"1": 25, "2": 50, "3": 100, "4": 200}[key]
    elif key == "l":
        state["labels"] = not state["labels"]
    elif key == "g":
        state["ground"] = not state["ground"]
    elif key == "p":
        state["paused"] = not state["paused"]
    elif key == "r":
        return True, True, True
    else:
        return True, False, False
    return True, True, False


def main():
    source = []
    state = {
        "range": DEFAULT_RANGE_NM,
        "selected": 0,
        "labels": True,
        "ground": False,
        "paused": False,
        "error": "",
        "sweep_deg": 0.0,
    }

    DATA_REFRESH_SECONDS = 2.0
    SWEEP_STEP_DEGREES = 30.0

    next_refresh = 0.0
    reload_now = True
    redraw_now = True

    while True:
        now = time.monotonic()

        # Refresh ADS-B data every two seconds. Advance the cosmetic sweep
        # exactly once per real data refresh, since Mystic's embedded Python
        # path does not reliably display timer-only animation frames.
        if reload_now or (not state["paused"] and now >= next_refresh):
            source, state["error"] = read_aircraft()
            state["sweep_deg"] = (
                state.get("sweep_deg", 0.0) + SWEEP_STEP_DEGREES
            ) % 360.0
            next_refresh = now + DATA_REFRESH_SECONDS
            reload_now = False
            redraw_now = True

        # Draw only when something meaningful changed.
        if redraw_now:
            draw_screen(source, state)
            redraw_now = False

        # Preserve the known-good Mystic input path.
        if bbs.keypressed:
            key, extended = bbs.getkey()
            running, changed, requested_reload = handle_key(key, state, source)
            if not running:
                break

            if requested_reload:
                reload_now = True

            if changed:
                redraw_now = True

        time.sleep(0.05)


main()
